# GTK3 applications take a long time to start
# SSH_AUTH_SOCK is set for all systemd user services via
# ~/.config/environment.d/ssh-agent.conf — Emacs runs as the emacs.service
# user unit so it inherits the socket. Apps started directly from sway are
# spawned too early to see the GNOME keyring socket.
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK
exec hash dbus-update-activation-environment 2>/dev/null && \
     dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK
# The sway session gets GH_TOKEN from ~/bin/sway-github-session, which
# sources ~/.config/gh/token.env at login.  Export it to systemd and DBus too.
exec sh -c 'set -a; [ -r "$HOME/.config/gh/token.env" ] && . "$HOME/.config/gh/token.env"; set +a; [ -n "$GH_TOKEN" ] && systemctl --user import-environment GH_TOKEN'
exec sh -c 'set -a; [ -r "$HOME/.config/gh/token.env" ] && . "$HOME/.config/gh/token.env"; set +a; [ -n "$GH_TOKEN" ] && dbus-update-activation-environment --systemd GH_TOKEN'
exec env RUST_BACKTRACE=1 RUST_LOG=swayr=debug swayrd > /tmp/swayrd.log 2>&1
# Sway Fader
# exec python3 ~/.config/sway/scripts/swayfader.py

# Start foot server
exec --no-startup-id foot --server

# Inhibit idle when audio is playing (e.g. video in Firefox)
exec sway-audio-idle-inhibit

# Blue light filter (auto-location via geoclue2)
exec gammastep -l geoclue2 -t 6500:3500

exec --no-startup-id waybound

# Live sticky-modifier (latched/locked Ctrl, Shift, Alt...) indicator for waybar.
# Sway does not expose modifier state over IPC, so the daemon reads the keyboard
# through evdev and mirrors the compositor's XKB state with libxkbcommon.
exec --no-startup-id $HOME/.config/waybar/scripts/sticky-modifiers-daemon.py
