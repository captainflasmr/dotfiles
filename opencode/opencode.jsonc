{
    "$schema": "https://opencode.ai/config.json",
    "model": "opencode-go/deepseek-v4.1-flash",
    "default_agent": "orchestrator",
    "snapshots": false,
    "experimental": {
        "subagent_depth": 1
    },
    "plugins": [
        {
            "package": "/home/jdyer/.config/opencode/plugins/jev",
            "options": {
                "apiKeyEnv": "TYPESAFE_API_KEY",
                "model": "jev-latest",
                "debug": false,
                "guard": {
                    "enabled": true,
                    "actions": ["edit", "shell"],
                    "denyConfidence": 0.6,
                    "destructiveNoul": 0.5,
                    "lowConfidence": 0.5,
                    "autoApprove": false,
                    "timeoutMs": 10000,
                    "contextMessages": 6,
                    "maxStateChars": 8000
                },
                "tool": { "enabled": true },
                "routing": {
                    "enabled": false,
                    "trivialAgent": "build",
                    "defaultAgent": "orchestrator",
                    "minConfidence": 0.7
                }
            }
        }
    ],
    "agents": {
        "orchestrator": {
            "description": "Lead planner (GLM-5.3). Researches with `explore`, produces a file-level plan, then IMMEDIATELY auto-delegates implementation to the `build` subagent. Reviews results and delegates corrective tasks as needed.",
            "mode": "primary",
            "model": "opencode-go/glm-5.3#max",
            "steps": 50,
            "request": {
                "body": {
                    "temperature": 0.2
                }
            },
            "system": "{file:prompts/glm-planner.md}",
            "permissions": [
                { "action": "edit", "resource": "*", "effect": "deny" },
                { "action": "shell", "resource": "*", "effect": "deny" }
            ]
        },
        "plan": {
            "description": "Pure plan mode (GLM-5.3). Read-only analysis & planning for review — NEVER auto-executes. Switch to `orchestrator` for plan-and-auto-implement, or `build` to edit directly.",
            "mode": "primary",
            "model": "opencode-go/glm-5.3#max",
            "steps": 50,
            "request": {
                "body": {
                    "temperature": 0.2
                }
            },
            "permissions": [
                { "action": "subagent", "resource": "*", "effect": "deny" },
                { "action": "subagent", "resource": "explore", "effect": "allow" },
                { "action": "edit", "resource": "*", "effect": "deny" },
                { "action": "shell", "resource": "*", "effect": "deny" }
            ]
        },
        "build": {
            "description": "Donkey-work implementer (deepseek-v4.1-flash). Fast, low-reasoning execution of delegated tasks from `orchestrator`; also directly selectable for quick edits.",
            "mode": "all",
            // "mode": "subagent",
            "model": "opencode-go/deepseek-v4.1-flash#max",
            "steps": 100
        },
        "explore": {
            "description": "Cheap codebase scanner (deepseek-v4.1-flash). Delegate broad searches here to keep planner token use low.",
            "model": "opencode-go/deepseek-v4.1-flash#max"
        },
        "general": {
            "description": "Complex research / multi-step tasks (GLM-5.3). Frontier thinking for non-trivial investigation.",
            "model": "opencode-go/glm-5.3#high"
        },
        "title": {
            "model": "opencode-go/deepseek-v4.1-flash#max"
        },
        "summary": {
            "model": "opencode-go/deepseek-v4.1-flash#max"
        },
        "compaction": {
            "model": "opencode-go/deepseek-v4.1-flash#max"
        }
    }
}
